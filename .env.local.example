# Besuchstracking: kostenloses Konto unter goatcounter.com erstellen
# Der "Code" ist der Subdomain-Teil: <code>.goatcounter.com
NEXT_PUBLIC_GOATCOUNTER_CODE=

# Anfrageformular: Endpoint, der JSON per POST annimmt und 200 {"ok":true} antwortet
NEXT_PUBLIC_INQUIRY_URL=

# Abstimmungsseite /abstimmung (intern): gleicher Lambda-Endpoint, Feedback-Strecke.
# Fällt auf NEXT_PUBLIC_INQUIRY_URL zurück; separat, damit die Vorschau das Anfrageformular inaktiv lassen kann.
NEXT_PUBLIC_FEEDBACK_URL=
